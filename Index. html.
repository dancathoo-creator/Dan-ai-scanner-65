
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dan Crypto Scanner AI</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#0b1020;color:#e8edf7;font-family:Arial,sans-serif}
header{background:#131d32;padding:20px;border-bottom:1px solid #293650}
h1{margin:0;color:#39d98a;font-size:23px}
.sub{color:#9ba9c0;font-size:12px;margin-top:7px}
main{padding:15px;max-width:1100px;margin:auto}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.card{background:#151f34;padding:15px;border-radius:10px;margin-bottom:12px}
.card small{color:#9ba9c0}
.card strong{display:block;font-size:21px;margin-top:8px}
.controls{display:flex;gap:8px;flex-wrap:wrap;margin:15px 0}
input,select,button{padding:12px;border:1px solid #34435d;border-radius:7px;background:#151f34;color:white}
input{flex:1;min-width:130px}
button{background:#087e50;border:0;font-weight:bold}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:12px 7px;text-align:left;border-bottom:1px solid #28344a}
th{color:#9ba9c0}
.up{color:#39d98a}.down{color:#ff6577}
.tablewrap{overflow-x:auto}
#result{line-height:1.8}
#status{color:#f5c76b;font-size:12px;margin:10px 0}
</style>
</head>
<body>
<header>
<h1>⚡ DAN CRYPTO SCANNER AI</h1>
<div class="sub">BINANCE USDT PERPETUAL FUTURES | LIVE MARKET SCANNER</div>
</header>
<main>
<div id="status">Connecting to Binance...</div>

<div class="stats">
<div class="card"><small>USDT pairs</small><strong id="pairs">--</strong></div>
<div class="card"><small>Market connection</small><strong id="connection">OFFLINE</strong></div>
<div class="card"><small>Top gainer</small><strong id="gainer">--</strong></div>
<div class="card"><small>Top loser</small><strong id="loser">--</strong></div>
</div>

<div class="card">
<h3>Market scanner</h3>
<div class="controls">
<input id="search" placeholder="Search BTC, ETH, ZEC...">
<select id="sort">
<option value="change">Top gainers</option>
<option value="losers">Top losers</option>
<option value="volume">Highest volume</option>
</select>
</div>
<div class="tablewrap">
<table>
<thead><tr><th>PAIR</th><th>PRICE</th><th>24H %</th><th>VOLUME USDT</th></tr></thead>
<tbody id="markets"><tr><td colspan="4">Loading markets...</td></tr></tbody>
</table>
</div>
</div>

<div class="card">
<h3>Technical analysis</h3>
<div class="controls">
<input id="coin" value="BTCUSDT" placeholder="Example BTCUSDT">
<select id="interval">
<option>1m</option><option>5m</option>
<option selected>15m</option><option>1h</option>
</select>
<button onclick="analyze()">ANALYZE</button>
</div>
<div id="result">Enter a trading pair and tap ANALYZE.</div>
</div>

<p class="sub">Data source: Binance USDⓈ-M Futures public market data. Signals are educational estimates, not guaranteed trading advice. No trades are executed.</p>
</main>

<script>
const API="https://fapi.binance.com";
let markets=[];
let socket;

const $=id=>document.getElementById(id);

function fmt(n){
 return Number(n).toLocaleString("en-US",
 {maximumFractionDigits:8});
}

async function loadMarkets(){
 try{
  const [info,tickers]=await Promise.all([
   fetch(API+"/fapi/v1/exchangeInfo").then(r=>r.json()),
   fetch(API+"/fapi/v1/ticker/24hr").then(r=>r.json())
  ]);

  const valid=new Set(info.symbols
   .filter(s=>s.contractType==="PERPETUAL" &&
   s.quoteAsset==="USDT" && s.status==="TRADING")
   .map(s=>s.symbol));

  markets=tickers.filter(t=>valid.has(t.symbol));
  $("pairs").textContent=markets.length;
  $("status").textContent="Market data loaded. Connecting live prices...";
  render();
  connectSocket();
 }catch(e){
  $("status").textContent="Could not load Binance data. Check internet and retry.";
 }
}

function render(){
 const q=$("search").value.toUpperCase();
 const mode=$("sort").value;

 let data=markets.filter(x=>x.symbol.includes(q));

 data.sort((a,b)=>{
  if(mode==="volume")return Number(b.quoteVolume)-Number(a.quoteVolume);
  if(mode==="losers")return Number(a.priceChangePercent)-Number(b.priceChangePercent);
  return Number(b.priceChangePercent)-Number(a.priceChangePercent);
 });

 $("gainer").textContent=markets.length?
  markets.reduce((a,b)=>+a.priceChangePercent>+b.priceChangePercent?a:b).symbol:"--";

 $("loser").textContent=markets.length?
  markets.reduce((a,b)=>+a.priceChangePercent<+b.priceChangePercent?a:b).symbol:"--";

 $("markets").innerHTML=data.slice(0,100).map(x=>{
  const change=Number(x.priceChangePercent);
  return `<tr>
  <td><b>${x.symbol}</b></td>
  <td>${fmt(x.lastPrice)}</td>
  <td class="${change>=0?'up':'down'}">${change.toFixed(2)}%</td>
  <td>${(Number(x.quoteVolume)/1000000).toFixed(2)}M</td>
  </tr>`;
 }).join("");
}

function connectSocket(){
 if(socket)socket.close();
 socket=new WebSocket("wss://fstream.binance.com/ws/!ticker@arr");

 socket.onopen=()=>{
  $("connection").textContent="LIVE";
  $("status").textContent="Connected to Binance live Futures prices.";
 };

 socket.onmessage=event=>{
  const updates=JSON.parse(event.data);
  updates.forEach(u=>{
   const m=markets.find(x=>x.symbol===u.s);
   if(m){
    m.lastPrice=u.c;
    m.priceChangePercent=u.P;
    m.quoteVolume=u.q;
   }
  });
  render();
 };

 socket.onclose=()=>{
  $("connection").textContent="RECONNECTING";
  setTimeout(connectSocket,5000);
 };

 socket.onerror=()=>socket.close();
}

function ema(values,period){
 let k=2/(period+1);
 let out=[values[0]];
 for(let i=1;i<values.length;i++)
  out.push(values[i]*k+out[i-1]*(1-k));
 return out;
}

function rsi(values,period=14){
 let gains=0,losses=0;
 for(let i=values.length-period;i<values.length;i++){
  let d=values[i]-values[i-1];
  if(d>0)gains+=d;
  else losses-=d;
 }
 if(losses===0)return 100;
 return 100-(100/(1+gains/losses));
}

async function analyze(){
 const symbol=$("coin").value.trim().toUpperCase();
 const interval=$("interval").value;
 $("result").textContent="Analyzing "+symbol+"...";

 try{
  const response=await fetch(API+
   "/fapi/v1/klines?symbol="+encodeURIComponent(symbol)+
   "&interval="+interval+"&limit=100");

  if(!response.ok)throw Error("Invalid pair or Binance unavailable");

  const candles=await response.json();
  const closes=candles.map(c=>Number(c[4]));
  const prices=closes.slice(0,-1);

  const fast=ema(prices,12);
  const slow=ema(prices,26);
  const signalLine=ema(fast.map((v,i)=>v-slow[i]),9);

  const last=prices[prices.length-1];
  const currentRSI=rsi(prices);
  const bullish=fast.at(-1)>slow.at(-1);
  const macd=fast.at(-1)-slow.at(-1);
  const signal=signalLine.at(-1);
  const momentum=bullish&&currentRSI>50&&macd>signal;
  const bearish=!bullish&&currentRSI<50&&macd<signal;

  let decision="WAIT / NO CLEAR SIGNAL";
  let color="#f5c76b";

  if(momentum){decision="BUY BIAS";color="#39d98a";}
  if(bearish){decision="SELL BIAS";color="#ff6577";}

  $("result").innerHTML=`
  <h3 style="color:${color}">${decision}</h3>
  Pair: <b>${symbol}</b><br>
  Timeframe: <b>${interval}</b><br>
  Last closed candle: <b>${fmt(last)}</b><br>
  RSI (14): <b>${currentRSI.toFixed(2)}</b><br>
  EMA 12: <b>${fmt(fast.at(-1))}</b><br>
  EMA 26: <b>${fmt(slow.at(-1))}</b><br>
  MACD: <b>${macd.toFixed(6)}</b><br>
  MACD signal: <b>${signal.toFixed(6)}</b><br>
  <hr>
  <b>Interpretation</b><br>
  EMA trend: ${bullish?"Bullish":"Bearish"}<br>
  RSI: ${currentRSI>70?"Overbought":currentRSI<30?"Oversold":"Neutral range"}<br>
  MACD: ${macd>signal?"Bullish crossover bias":"Bearish crossover bias"}<br>
  <small>Confirm with volume, support, resistance and risk management before trading. This is not a guaranteed entry signal.</small>`;
 }catch(e){
  $("result").textContent="Analysis failed: "+e.message;
 }
}

$("search").addEventListener("input",render);
$("sort").addEventListener("change",render);

loadMarkets();
</script>
</body>
</html>
